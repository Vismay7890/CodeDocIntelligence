# Use Set-Content or Out-File
"venv/" | Out-File -Encoding utf8 .gitignore
"chroma_db/" | Out-File -Encoding utf8 -Append .gitignore
"__pycache__/" | Out-File -Encoding utf8 -Append .gitignore
"*.pyc" | Out-File -Encoding utf8 -Append .gitignore
".env" | Out-File -Encoding utf8 -Append .gitignore
".DS_Store" | Out-File -Encoding utf8 -Append .gitignore
"Thumbs.db" | Out-File -Encoding utf8 -Append .gitignore